-- Retro-hunt variant of ${name}. Generated by Terraform: edit queries/${name}.sql instead.
-- Runs once, over the full lookback, whenever the threat-intel indicator set changes,
-- so a newly added indicator is checked against history, not only against new traffic.
-- findings_total (first column) is the full count even when the alert shows only a sample.
SELECT count(*) OVER () AS findings_total, hunt.*
FROM (
${inner}
) AS hunt
