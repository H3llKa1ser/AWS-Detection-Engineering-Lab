-- Active (unexpired) indicators, normalised. IPv4 and CIDR rows become an
-- integer range [lo, hi] so one BETWEEN matches both; a misaligned CIDR base
-- (198.51.100.5/28) is aligned down to its network. Rendered by Terraform
-- into hunts 22-24 through the intel_active template variable.
intel_raw AS (
  SELECT
    lower(trim(indicator)) AS indicator,
    lower(trim(type)) AS type,
    trim(source) AS source,
    lower(trim(confidence)) AS confidence,
    trim(description) AS description,
    trim(reference) AS reference,
    split_part(lower(trim(indicator)), '/', 1) AS address,
    CASE WHEN lower(trim(type)) = 'cidr' THEN TRY_CAST(split_part(trim(indicator), '/', 2) AS integer) ELSE 32 END AS prefix_len
  FROM "${database}"."${intel_table}"
  WHERE trim(expires) >= date_format(current_date, '%Y-%m-%d')
),
intel_int AS (
  SELECT *,
    CASE WHEN type IN ('ipv4', 'cidr') AND regexp_like(address, '^[0-9]{1,3}([.][0-9]{1,3}){3}$')
         THEN (TRY_CAST(split_part(address, '.', 1) AS bigint) * 16777216 + TRY_CAST(split_part(address, '.', 2) AS bigint) * 65536 + TRY_CAST(split_part(address, '.', 3) AS bigint) * 256 + TRY_CAST(split_part(address, '.', 4) AS bigint)) END AS base_int,
    CAST(power(2, 32 - prefix_len) AS bigint) AS block_size
  FROM intel_raw
),
intel AS (
  SELECT
    indicator, type, source, confidence, description, reference,
    CASE WHEN type = 'domain' THEN 'domain' ELSE 'ip' END AS kind,
    CASE confidence WHEN 'high' THEN 3 WHEN 'medium' THEN 2 ELSE 1 END AS confidence_rank,
    base_int - (base_int % block_size) AS lo,
    base_int - (base_int % block_size) + block_size - 1 AS hi
  FROM intel_int
  WHERE type = 'domain' OR base_int IS NOT NULL
)
