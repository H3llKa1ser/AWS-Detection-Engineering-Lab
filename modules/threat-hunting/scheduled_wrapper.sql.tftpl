-- Scheduled variant of ${name}. Generated by Terraform: edit queries/${name}.sql instead.
-- Reports only rows whose ${time_column} falls in [run time - ${start_hours}h, run time - ${end_hours}h).
-- Daily runs make these windows contiguous, so each finding is reported once; the
-- ${end_hours}h lag leaves time for CloudTrail to deliver late events before they are judged.
-- findings_total (first column) is the full count even when the alert shows only a sample.
SELECT count(*) OVER () AS findings_total, hunt.*
FROM (
${inner}
) AS hunt
WHERE hunt.${time_column} >= current_timestamp - interval '${start_hours}' hour
  AND hunt.${time_column} <  current_timestamp - interval '${end_hours}' hour
ORDER BY hunt.${time_column} DESC
