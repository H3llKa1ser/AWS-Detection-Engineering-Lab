# Copy to terraform.tfvars and edit.

aws_region  = "eu-west-1"
name_prefix = "detlab"

# Get paged. You must confirm the subscription email AWS sends you.
alert_email = "you@example.com"

# Forward GuardDuty medium and above.
min_guardduty_severity = 4

# Toggle layers while you learn / to keep spend down.
enable_config              = true
enable_guardduty           = true
enable_securityhub         = true
kms_encrypt_logs           = true

# Opt-in: lets a Lambda revoke offending security-group rules automatically.
enable_response_automation = false

# --- Network telemetry ---
enable_vpc_flow_logs       = true
enable_dns_query_logging   = true
create_lab_vpc             = true
lab_vpc_cidr               = "10.42.0.0/16"
network_log_retention_days = 30

# Attach telemetry to existing VPCs with real workloads (needed to exercise
# the flow-log detections; the isolated lab VPC has no inbound/outbound path).
monitored_vpc_ids = []

# Opt-in: one t3.micro that generates DNS traffic to fire the DNS detections.
deploy_traffic_generator = false

# --- DNS Firewall ---
enable_dns_firewall = true

# Enforce on monitored_vpc_ids too (changes DNS answers for real workloads).
dns_firewall_protect_monitored_vpcs = false

# Production rollout: start with ALERT, review the logs, then switch to BLOCK.
dns_firewall_managed_lists = [
  { name = "AWSManagedDomainsMalwareDomainList", action = "BLOCK" },
  { name = "AWSManagedDomainsBotnetCommandandControl", action = "BLOCK" },
  { name = "AWSManagedDomainsAggregateThreatList", action = "BLOCK" },
]

dns_firewall_block_domains  = ["nanopool.org", "supportxmr.com", "minexmr.com", "moneroocean.stream", "hashvault.pro"]
dns_firewall_allow_domains  = []
dns_firewall_block_response = "NODATA"
dns_firewall_fail_open      = false

# Only needed without the AWS CLI (e.g. CI): name => rslvr-fdl-... for every list above.
# dns_firewall_managed_list_ids = {}

# --- DNS Firewall Advanced (behavioural; no domain list) ---
# Production rollout: ALERT at LOW first, review, then BLOCK at MEDIUM or HIGH.
dns_firewall_advanced_protections = [
  { protection = "DGA", action = "BLOCK", confidence = "MEDIUM" },
  { protection = "DICTIONARY_DGA", action = "BLOCK", confidence = "MEDIUM" },
  { protection = "DNS_TUNNELING", action = "BLOCK", confidence = "MEDIUM" },
]
dns_firewall_advanced_alarm_threshold = 1

# --- Threat hunting (Athena over CloudTrail) ---
enable_threat_hunting        = true
hunting_projection_start     = "2025/01/01"
hunting_lookback_days        = 30
hunting_recent_days          = 1
hunting_bytes_scanned_cutoff = 10737418240 # 10 GiB per query

# --- Scheduled hunts (daily; alert only on findings or failures) ---
enable_scheduled_hunts = true
hunt_schedule_hour     = 6
hunt_schedule_timezone = "UTC"
scheduled_hunts = [
  "01_console_login_new_source",
  "02_console_bruteforce_then_success",
  "03_permission_probing",
  "05_iam_persistence",
  "06_defense_evasion_sensor_tampering",
  "07_new_region_activity",
  "08_data_shared_to_other_accounts",
  "09_compute_hijacking",
  "12_root_activity",
  "13_new_role_assumption_path",
  # Add once tuned for your environment:
  # "04_enumeration_burst", "10_secret_harvesting", "11_instance_credentials_replayed",
]

# --- Network log lake (flow + DNS as Parquet in S3, Athena tables, network hunts) ---
# Adds a second flow log per monitored VPC; AWS allows 2 per VPC.
enable_network_log_lake     = true
network_lake_retention_days = 90
